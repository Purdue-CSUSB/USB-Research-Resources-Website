# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string (Atlas format shown; any valid mongodb:// or
# mongodb+srv:// URI works). Database name (usb_board) is set in lib/db.js.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/usb_board?retryWrites=true&w=majority

# Groq API key for AI moderation of project submissions. Groq keys start with "gsk_".
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# Secret used to sign login JWTs. Use a long random string, e.g. generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_hex_string

# SMTP settings used to email submitters when their project goes live.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="USB Research Resources <no-reply@yourdomain.com>"

# Google service account used by the calendar scraper (see scrapers/syncCalendar.js).
# GOOGLE_PRIVATE_KEY must keep its literal "\n" line breaks (the app un-escapes them),
# and the whole value should be quoted since it contains special characters.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# EmailJS settings used to notify admins of a new project submission.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=user_xxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of origins allowed to call the API via CORS.
# Defaults to http://localhost:5173 if unset. Add your deployed frontend origin, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://purdue-csusb.github.io
ALLOWED_ORIGINS=
# Set to the number of proxy hops (e.g. 1) ONLY when deployed behind a reverse proxy, so
# rate limiting keys on the real client IP. Leave blank/unset in local dev.
TRUST_PROXY=
