# Copy this file to .env (in this same directory - the repo root) and fill in real values.
# One .env serves the whole repo: the api/ functions and the backend/ scripts read from here.
# Never commit the real .env.
#
# In production these are set in the Vercel dashboard (Settings -> Environment Variables)
# rather than from a file.
#
# Everything here is a secret or a per-deployment connection detail. Public settings that don't
# vary between environments - the @purdue.edu signup domain, the 3-project cap, the Google
# Calendar id and its timezone - are plain constants in backend/lib/constants.js and
# frontend/src/config.js instead, so they are not repeated here.
#
# The frontend reads NOTHING from this file. Nothing in .env is ever compiled into the browser
# bundle, so a value here cannot leak into shipped JavaScript.
#
# There are no fallback defaults anywhere in the code: a missing variable throws a clear error
# instead of silently running on a guessed value.

# --- Database ---------------------------------------------------------------
# MongoDB connection string (Atlas format shown; any valid mongodb:// or mongodb+srv:// URI
# works). Use a DB user scoped to readWrite on this database only - not an Atlas admin user.
# Serverless functions have no static egress IP, so Atlas network access has to allow
# 0.0.0.0/0, which makes the strength and scope of this credential the thing actually
# protecting the database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name inside that cluster. Point a local checkout at a scratch DB by changing this.
MONGODB_DB=usb_board

# --- Login tokens -----------------------------------------------------------
# Secret used to sign login JWTs. Generate one with:  openssl rand -hex 32
# Changing it invalidates every existing login.
JWT_SECRET=replace_with_a_long_random_hex_string

# How long a login lasts. Any value the `ms` library understands (2h, 30m, 7d).
JWT_TTL=2h

# --- AI moderation of submissions -------------------------------------------
# Groq API key. Keys start with "gsk_".
GROQ_API_KEY=gsk_replace_with_your_own_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Outbound email ---------------------------------------------------------
# One SMTP account sends everything: verification codes, password reset codes, the "your
# project was posted" note, and the new-submission notice to the admin below.
# Gmail works free (~500 recipients/day) with an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="USB Research Resources <no-reply@yourdomain.com>"

# Who gets notified when someone posts a project. If this email fails to send, the submission
# still succeeds and the response carries a warning instead.
ADMIN_EMAIL=admin@purdue.edu

# --- Calendar scraper -------------------------------------------------------
# Google service account credentials for backend/scrapers/syncCalendar.js. Only `npm run
# scrape` and the GitHub Action need these; the calendar id itself is public and lives in
# backend/lib/constants.js. GOOGLE_PRIVATE_KEY must keep its literal "\n" line breaks (the app
# un-escapes them), and must be quoted.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"

# --- Database keepalive -----------------------------------------------------
# Public base URL of the deployed site, used by `npm run keepalive`
# (backend/scripts/keepDatabaseAwake.js) to make one request a day to /api/projects so Atlas never
# reaches its 30-day inactivity timeout. Not a secret.
#
# In CI this comes from a GitHub Actions *variable* named SITE_URL rather than from this file
# (Settings -> Secrets and variables -> Actions -> Variables). Set it here only if you want to
# run the keepalive locally. No trailing slash needed - the script strips one.
SITE_URL=https://your-deployment.vercel.app

# Not used anymore: ALLOWED_ORIGINS, TRUST_PROXY and PORT. The API is served same-origin with
# the frontend, so there is no CORS allowlist to maintain and no port to bind, and the real
# client IP comes from Vercel's own x-vercel-forwarded-for header (backend/lib/http.js).
